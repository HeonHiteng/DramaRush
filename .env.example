# Copy this file to `.env` and fill in the values from your Supabase project's
# Settings → API page (see the DramaRush-Backend repo README for full setup).
# Expo automatically inlines EXPO_PUBLIC_* variables at build time — no extra
# config needed. Never commit your actual .env file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
